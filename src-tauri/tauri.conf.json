{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VontaqFS",
  "version": "0.2.0",
  "identifier": "fs.vontaq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VontaqFS",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:47833 http://localhost:47834 http://localhost:47835 http://localhost:47836 http://127.0.0.1:47833 http://127.0.0.1:47834 http://127.0.0.1:47835 http://127.0.0.1:47836",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first persistent storage runtime for compatible Figma integrations",
    "longDescription": "VontaqFS provides isolated local persistence, filesystem-like storage and large-data handling for compatible Figma integrations.",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
