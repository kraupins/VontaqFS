{
  "name": "@vontaq/fs",
  "version": "0.2.1",
  "description": "Local-first TypeScript SDK for the VontaqFS desktop storage runtime",
  "license": "LicenseRef-VontaqFS-Source-Available-1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./figma": {
      "types": "./dist/figma.d.ts",
      "import": "./dist/figma.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kraupins/VontaqFS.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "prepack": "node ../../scripts/release/prepare-sdk-package.mjs prepare",
    "postpack": "node ../../scripts/release/prepare-sdk-package.mjs cleanup"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "sideEffects": false,
  "keywords": [
    "vontaqfs",
    "local-first",
    "storage",
    "figma",
    "typescript",
    "desktop"
  ],
  "homepage": "https://github.com/kraupins/VontaqFS#readme",
  "bugs": {
    "url": "https://github.com/kraupins/VontaqFS/issues"
  }
}
